#!/usr/bin/env bash
# Map, address and desktop-notification helpers. Vehicle data comes from MQTT.
set -uo pipefail
here=$(cd "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
CACHE_DIR="${OMARCHY_TESLA_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-teslamate}"
PLACE_JQ="$here/place.jq"
PLACE_CACHE_USABLE='.ok == true and (.number_first | type == "boolean")'
MAP_UA="omarchy-teslamate/2.0 (+https://github.com/simbesh/omarchy-tesla)"
TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
die() { printf 'tesla: %s\n' "$*" >&2; exit 1; }
fail_json() {
  jq -cn --arg error "${1:-error}" --arg hint "${2-}" '{ok: false, error: $error, hint: $hint}'
  exit 0
}
(umask 077; mkdir -p "$CACHE_DIR/tiles" "$CACHE_DIR/places")
write_private() {
  local path="$1"
  ( umask 077; cat > "$path" )
}

# A place-cache file is usable only when it was written by place.jq.
# jq -e prints true/false; discard that or a cache hit becomes two lines.
place_cache_usable() {
  [ -s "$1" ] || return 1
  jq -e "$PLACE_CACHE_USABLE" "$1" >/dev/null 2>&1
}

cmd_map() {
  local lat="$1" lon="$2" zoom="$3" width="$4" height="$5"

  case "$lat$lon$zoom$width$height" in
    *[!0-9.\-]*) fail_json "map wants numbers" ;;
  esac

  local plan
  plan=$(awk -v lat="$lat" -v lon="$lon" -v z="$zoom" -v w="$width" -v h="$height" '
    BEGIN {
      pi = 3.14159265358979
      size = 256
      n = 2 ^ z
      rad = lat * pi / 180
      # Web Mercator: longitude is linear, latitude runs through the log-tangent.
      fx = (lon + 180) / 360 * n
      fy = (1 - log((sin(rad) / cos(rad)) + (1 / cos(rad))) / pi) / 2 * n

      # Where the car sits in world pixels, and the window we want around it.
      cx = fx * size
      cy = fy * size
      left = cx - w / 2
      top  = cy - h / 2

      x0 = int(left / size); if (left < 0 && left != x0 * size) x0--
      y0 = int(top  / size); if (top  < 0 && top  != y0 * size) y0--
      x1 = int((left + w - 1) / size); if ((left + w - 1) < 0) x1--
      y1 = int((top  + h - 1) / size); if ((top  + h - 1) < 0) y1--

      # The car is dead centre by construction; printing it keeps the QML from
      # having to trust that.
      printf "car %d %d\n", int(w / 2 + 0.5), int(h / 2 + 0.5)

      for (ty = y0; ty <= y1; ty++) {
        for (tx = x0; tx <= x1; tx++) {
          # Off the top or bottom of the world there is no tile; wrap around
          # the date line rather than asking for a column that does not exist.
          if (ty < 0 || ty >= n) continue
          wx = tx % n; if (wx < 0) wx += n
          printf "tile %d %d %d %d\n", wx, ty, int(tx * size - left + 0.5), int(ty * size - top + 0.5)
        }
      }
    }')

  local car_x car_y
  car_x=$(printf '%s' "$plan" | awk '/^car/ {print $2}')
  car_y=$(printf '%s' "$plan" | awk '/^car/ {print $3}')

  local tiles="[]"
  while read -r _ tx ty px py; do
    [ -n "${tx:-}" ] || continue
    local path
    path=$(fetch_tile "$zoom" "$tx" "$ty") || continue
    tiles=$(printf '%s' "$tiles" | jq -c --arg path "$path" --argjson px "$px" --argjson py "$py" \
      '. + [{path: $path, x: $px, y: $py}]')
  done < <(printf '%s' "$plan" | grep '^tile')

  jq -cn --argjson tiles "$tiles" --argjson w "$width" --argjson h "$height" \
    --argjson cx "${car_x:-0}" --argjson cy "${car_y:-0}" --argjson z "$zoom" '
    {ok: true, width: $w, height: $h, zoom: $z, tileSize: 256,
     carX: $cx, carY: $cy, tiles: $tiles,
     attribution: "© OpenStreetMap contributors"}'
}

# Tiles are immutable for practical purposes, so one that is on disk is never
# fetched again. This is the whole of being a good guest on a free tile server.
fetch_tile() {
  local z="$1" x="$2" y="$3"
  local dir="$CACHE_DIR/tiles/$(printf '%s' "$TILE_URL" | md5sum | cut -c1-8)/$z/$x"
  local path="$dir/$y.png"

  if [ -s "$path" ]; then printf '%s' "$path"; return 0; fi

  ( umask 077; mkdir -p "$dir" )
  local url="${TILE_URL//\{z\}/$z}"
  url="${url//\{x\}/$x}"
  url="${url//\{y\}/$y}"

  if curl -sS -f -m 20 -A "$MAP_UA" -o "$path.part" "$url" 2>/dev/null && [ -s "$path.part" ]; then
    mv -f "$path.part" "$path"
    printf '%s' "$path"
    return 0
  fi

  rm -f "$path.part"
  return 1
}

# Where the car is, in words. Nominatim asks for no more than one call a
# second and would rather you cached; coordinates are rounded to about ten
# metres first, so a car sitting still is one lookup however often you look.
#
# Formatting lives in place.jq, next to this script: country of the pin
# decides number-first vs number-last, and US/CA/AU get a region suffix.
# The parked line is `place`. The panel drops the house number on screen
# while moving; this cache is keyed by coordinates, so it does not change.
cmd_place() {
  local lat="$1" lon="$2"
  local key path response formatted

  # Same check `map` makes. These are pasted straight into a query string, and
  # a coordinate that is not a number is not a coordinate.
  case "$lat$lon" in
    *[!0-9.\-]*|'') fail_json "place wants numbers"; return 0 ;;
  esac

  key=$(awk -v a="$lat" -v b="$lon" 'BEGIN { printf "%.4f_%.4f", a, b }')
  path="$CACHE_DIR/places/$key.json"

  if place_cache_usable "$path"; then cat "$path"; return 0; fi

  [ -f "$PLACE_JQ" ] || fail_json "no address" "place.jq is missing next to bin/tesla"

  response=$(curl -sS -f -m 20 -A "$MAP_UA" \
    "https://nominatim.openstreetmap.org/reverse?format=jsonv2&zoom=18&lat=$lat&lon=$lon" 2>/dev/null) \
    || fail_json "no address"

  formatted=$(printf '%s' "$response" | jq -c -f "$PLACE_JQ") || fail_json "no address"
  [ -n "$formatted" ] || fail_json "no address"
  printf '%s' "$formatted" | write_private "$path"
  cat "$path"
}

# ----------------------------------------------------------------- notifying

# The panel could call notify-send itself, but every line that reaches the
# desktop from this plugin goes through here, where the text is an argument
# and never a command, and where the answer is a line of JSON like everything
# else's.
cmd_notify() {
  local title="$1" body="${2-}"
  command -v notify-send >/dev/null 2>&1 || fail_json "notify-send is not installed"
  notify-send -a Tesla -i car -- "$title" "$body" >/dev/null 2>&1 \
    || fail_json "notify-send failed"
  printf '{"ok":true}\n'
}


if [ "${1-}" = "--tile-url" ]; then TILE_URL="$2"; shift 2; fi
command="${1-}"; [ $# -gt 0 ] && shift
case "$command" in
  stream) exec "${OMARCHY_TESLA_PYTHON:-python3}" "$here/teslamate.py" "$@" ;;
  map) [ $# -eq 5 ] || die "map wants LAT LON ZOOM WIDTH HEIGHT"; cmd_map "$@" ;;
  place) [ $# -eq 2 ] || die "place wants LAT LON"; cmd_place "$@" ;;
  notify) [ $# -ge 1 ] && [ $# -le 2 ] || die "notify wants TITLE [BODY]"; cmd_notify "$@" ;;
  *) die "Use stream [--host HOST --port PORT --topic teslamate/cars/1], map, place, or notify" ;;
esac
